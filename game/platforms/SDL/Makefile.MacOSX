#
# Modification History
#
# 2006-June-27    Jason Rohrer
# Created.  Adapted from Transcend project.
#
# 2026-August-20    Antinoid
# Modernized for 64-bit macOS.  The SDL 1.2 framework this used to link
# against no longer exists on any current system, so SDL now comes from
# Homebrew's sdl12-compat, found through sdl-config.
#
# 2026-September-16    hobby-dev
# Added MacPorts support, auto-detected (its sdl-config hardcodes stale
# paths, so the libexec layout is read directly instead), plus
# MACOSX_ARCHS/MACOSX_DEPLOYMENT_TARGET for universal builds -- see
# build/macOSX/installMacPortsDeps.sh.
#


##
# The common MacOSX portion of Makefiles.
# Should not be made manually---used by configure to build Makefiles.
##


# Homebrew: /opt/homebrew (Apple Silicon) or /usr/local (Intel), via `brew
# --prefix`.  MacPorts: always /opt/local (no query subcommand for it).
BREW_PREFIX := $(shell brew --prefix 2>/dev/null)
PORT_BIN := $(shell command -v port 2>/dev/null)

ifneq ($(BREW_PREFIX),)
  PKG_MANAGER := brew
  PKG_PREFIX := $(BREW_PREFIX)
else ifneq ($(PORT_BIN),)
  PKG_MANAGER := port
  PKG_PREFIX := /opt/local
else
  PKG_MANAGER := none
  PKG_PREFIX := /usr/local
endif


# Override with `make MACOSX_ARCHS="arm64 x86_64"` for a universal binary --
# needs every linked library built universal first (MacPorts:
# installMacPortsDeps.sh; Homebrew ships no universal bottles).
MACOSX_ARCHS ?= $(shell uname -m)
ARCH_FLAGS := $(foreach a,$(MACOSX_ARCHS),-arch $(a))


# Override with `make MACOSX_DEPLOYMENT_TARGET=10.13`; must match what the
# bundled libraries were built for (installMacPortsDeps.sh).
MACOSX_DEPLOYMENT_TARGET ?= 11.0
MIN_VERSION_FLAGS := -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET)


ifeq ($(PKG_MANAGER),port)
  SDL_PREFIX := $(PKG_PREFIX)/libexec/sdl12-compat
  SDL_CFLAGS := -I$(SDL_PREFIX)/include
  SDL_LIBS := -L$(SDL_PREFIX)/lib -lSDLmain -lSDL -Wl,-framework,Cocoa
else
  SDL_CFLAGS := $(shell sdl-config --cflags)
  SDL_LIBS := $(shell sdl-config --libs)
endif


# __mac__ triggers the mac-specific code paths in minorGems (working
# directory handling for .app bundles, <OpenGL/gl.h> instead of <GL/gl.h>,
# the SDLMain_Ext.h menu bar helper).
# BSD picks the right branch in minorGems/system/endian.h.
#
# Split into a no-arch base plus the real flags: clang can't write one -MM
# dependency file for multiple -arch flags, so both g++ -MM sites below
# (the %.dep rule and the minorGems bulk scan) force the arch-free version.
PLATFORM_COMPILE_FLAGS_NOARCH = $(MIN_VERSION_FLAGS) -DBSD -D__mac__ -DGL_SILENCE_DEPRECATION -I$(PKG_PREFIX)/include $(SDL_CFLAGS) -D_THREAD_SAFE
PLATFORM_COMPILE_FLAGS = $(ARCH_FLAGS) $(PLATFORM_COMPILE_FLAGS_NOARCH)

%.dep: PLATFORM_COMPILE_FLAGS = $(PLATFORM_COMPILE_FLAGS_NOARCH)
Makefile.minorGems_dependencies: PLATFORM_COMPILE_FLAGS = $(PLATFORM_COMPILE_FLAGS_NOARCH)


# MenuBarHelper.m rather than SDLMain.m:  sdl12-compat's libSDLmain.a
# already provides main(), and SDL_main.h renames the game's own main() to
# SDL_main() on mac, so compiling all of SDLMain.m would define main twice.
# MenuBarHelper.m supplies just the NSMenu_setMenuBarVisible that
# ScreenGL_SDL.cpp needs for fullscreen.
PLATFORM_LINK_FLAGS = $(ARCH_FLAGS) $(MIN_VERSION_FLAGS) -framework OpenGL -L$(PKG_PREFIX)/lib $(SDL_LIBS) ${ROOT_PATH}/minorGems/game/platforms/SDL/mac/MenuBarHelper.m ${CUSTOM_MACOSX_LINK_FLAGS}

# for headless builds with no GL or SDL
PLATFORM_LINK_FLAGS_HEADLESS = $(ARCH_FLAGS) $(MIN_VERSION_FLAGS) ${CUSTOM_MACOSX_LINK_FLAGS}



# not used for some builds
PLATFORM_LIBJPEG_FLAG = -ljpeg

# not used for some builds
# libpng depends on zlib, so the order of these matters
PLATFORM_LIBPNG_FLAG = -lpng -lz


# g++ is clang on macOS
GXX = g++ 
LINK_FLAGS =



##
# Platform-specific minorGems file path prefixes
##

PLATFORM = Linux
PLATFORM_PATH = linux

TIME_PLATFORM = Unix
TIME_PLATFORM_PATH = unix

DIRECTORY_PLATFORM = Unix
DIRECTORY_PLATFORM_PATH = unix

POLL_PLATFORM = Unix
POLL_PLATFORM_PATH = unix

# PLATFORM_DISCORD_SDK_FLAG = -Wl,-Bdynamic -ldiscord_game_sdk -L$(DISCORD_SDK_PATH)/lib/x86_64 -Wl,-Bstatic
ifneq ($(DISCORD_SDK_PATH),)
$(error DISCORD SDK NOT IMPLEMENTED FOR THIS PLATFORM, DISABLE IT)
endif
